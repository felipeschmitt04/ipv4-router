#!/usr/bin/env python3
"""injetar ARQUIVO [INTERFACE]

Envia pela interface (eth0, se omitida) o quadro Ethernet escrito no arquivo em
dígitos hexadecimais, do primeiro byte do cabeçalho Ethernet ao último byte do
quadro. Espaços e quebras de linha são livres. O quadro sai exatamente como está
no arquivo: nada é completado nem calculado.
"""
import re
import socket
import sys

if len(sys.argv) not in (2, 3):
    print("uso: injetar ARQUIVO [INTERFACE]", file=sys.stderr)
    sys.exit(2)

interface = sys.argv[2] if len(sys.argv) == 3 else "eth0"
with open(sys.argv[1], encoding="utf-8") as f:
    texto = re.sub(r"\s+", "", f.read())

if not re.fullmatch(r"[0-9a-fA-F]*", texto) or len(texto) % 2:
    print("o arquivo precisa ter só dígitos hexadecimais, em número par", file=sys.stderr)
    sys.exit(1)
quadro = bytes.fromhex(texto)
if not 14 <= len(quadro) <= 1514:
    print(f"o quadro tem {len(quadro)} bytes; precisa ter de 14 a 1514", file=sys.stderr)
    sys.exit(1)

s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW)
s.bind((interface, 0))
s.send(quadro)
print(f"{len(quadro)} bytes enviados por {interface}")
